  "hiddenInteractionPlan": [
    {
      "target": "dashboard",
      "pattern": "project-switch-sheet",
      "description": "项目切换区以抽屉式入口表达，可在主流程中接入真实切换逻辑。"
    },
    {
      "target": "project-detail",
      "pattern": "segmented-content",
      "description": "概况、测孔、成员采用分段切换，保留移动端单页层级而不拆成多表格页面。"
    },
    {
      "target": "hole-monitor",
      "pattern": "task-log-sheet",
      "description": "任务记录入口作为底部弹层触发位，满足现场快速查看而不离开主任务页。"
    },
    {
      "target": "trend-analysis",
      "pattern": "filter-drawer",
      "description": "工程、测孔、时间筛选保留抽屉式容器语义，便于后续接入 uniapp 条件筛选组件。"
    }
  ]
