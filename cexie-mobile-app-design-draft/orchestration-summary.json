  "hiddenInteractionPlan": [
    {
      "target": "projects",
      "pattern": "project-switch-sheet",
      "description": "工程切换保留为顶部抽屉式入口，适合现场快速更换当前联调项目。"
    },
    {
      "target": "devices",
      "pattern": "engine-filter-sheet",
      "description": "设备列表顶部工程筛选保留为快速上下文切换入口，默认展示全部工程。"
    },
    {
      "target": "devices",
      "pattern": "status-filter-segment",
      "description": "在线、离线、故障、全部使用分段筛选，保证设备列表首屏即能聚焦关键设备。"
    },
    {
      "target": "devices",
      "pattern": "device-card-open",
      "description": "设备卡片整卡点击进入设备操作页，维持现场调试主入口清晰。"
    },
    {
      "target": "device-operation",
      "pattern": "back-context-return",
      "description": "设备操作页返回按钮回到当前工程或当前筛选上下文的设备列表。"
    }
  ]
