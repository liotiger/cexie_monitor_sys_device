  "deviceType": "mobile",
  "language": "zh-CN",
  "designSource": {
    "operatingMode": "free-explore"
  },
  "brandPrefix": "cexie",
  "themeMode": "light",
  "designRead": [
    "这是面向现场工程师与调试工程师的设备联调工具画布。",
    "主流程围绕工程入口、设备列表默认入口、设备操作台展开。",
    "视觉与交互保持蓝灰工程监测气质，但强化操作台感与现场弱网场景表达。",
    "工程页承担现场入口与项目切换，设备列表承担筛选与选设备，设备操作页承担调试执行与回执确认。"
  ],
  "designDials": {
    "tone": "现场操作台",
    "informationDensity": "medium",
    "surfaceStyle": "light-card",
    "actionFeedback": "explicit",
    "motionIntensity": 1,
    "radiusScale": "restrained",
    "navigationPattern": "top-bar-plus-bottom-tab",
    "workspacePriority": "device-debug-first",
    "contentCompression": "higher-than-base"
  },
  "pages": [
